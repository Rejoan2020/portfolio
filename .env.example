# Copy to .env.local for development; set the same keys in Vercel project settings for production.

# Upstash Redis — the shared click total and its rate limiter.
# Connecting Upstash through the Vercel Marketplace sets these (or the KV_REST_API_URL / KV_REST_API_TOKEN aliases).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — daily private snapshots of the total. Set automatically when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Long random string; Vercel Cron sends it as a Bearer token to /api/counter-backup.
CRON_SECRET=

# Optional: canonical origin for metadata, sitemap and robots.txt. Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=
